@using HospitalMS.BLL.ModelVM.Department
@model NewDepartmentViewModel

@{
    ViewData["Title"] = "Create Department";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Management</p>
                <h1 class="h3 mb-1">Create Department</h1>
                <p class="text-muted mb-0">Create a new department.</p>
            </div>
        </div>
    </div>

    <section class="row g-3">
        <div class="col-12">
            <form asp-action="Create" method="post" class="panel">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="panel-header">
                    <h2 class="h5 mb-1 section-title">Department Information</h2>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label">Department Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter department name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-plus-circle"></i> Create Department
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}