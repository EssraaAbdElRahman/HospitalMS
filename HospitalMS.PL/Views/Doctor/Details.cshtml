@using HospitalMS.BLL.ModelVM.Doctor
@model DoctorDetailsViewModel

@{
    ViewData["Title"] = "Doctor Details";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Doctors</p>
                <h1 class="h3 mb-1">@Model.Name</h1>
                <p class="text-muted mb-0">@Model.DepartmentName · @Model.SpecialtyName</p>
            </div>
        </div>
        <div class="heading-actions d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-permission="Doctors.Edit" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <section class="panel mt-3">
        <div class="panel-header">
            <h2 class="h5 mb-0 section-title">Doctor Information</h2>
        </div>
        <div class="p-3">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted fw-normal">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 text-muted fw-normal">National ID</dt>
                <dd class="col-sm-9">@Model.NationalId</dd>

                <dt class="col-sm-3 text-muted fw-normal">Department</dt>
                <dd class="col-sm-9">@Model.DepartmentName</dd>

                <dt class="col-sm-3 text-muted fw-normal">Specialty</dt>
                <dd class="col-sm-9">@Model.SpecialtyName</dd>

                <dt class="col-sm-3 text-muted fw-normal">Years Of Experience</dt>
                <dd class="col-sm-9">@Model.YearsOfExperience</dd>

                <dt class="col-sm-3 text-muted fw-normal">Hire Date</dt>
                <dd class="col-sm-9">@Model.HireDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3 text-muted fw-normal">Salary</dt>
                <dd class="col-sm-9">@Model.Salary.ToString("N2")</dd>

                <dt class="col-sm-3 text-muted fw-normal">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>

                <dt class="col-sm-3 text-muted fw-normal">Bio</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Bio) ? "—" : Model.Bio)</dd>
            </dl>
        </div>
    </section>

    <section class="panel mt-3">
        <div class="panel-header">
            <h2 class="h5 mb-0 section-title">Doctor Schedule</h2>
            <a asp-controller="DoctorSchedule" asp-action="Create" asp-route-doctorId="@Model.Id"
               asp-permission="Doctors.Schedule" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Schedule
            </a>
        </div>
        <div class="p-3">
            @if (Model.Schedules != null && Model.Schedules.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Days</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.Schedules)
                            {
                                <tr>
                                    <td>@schedule.Days</td>
                                    <td>@schedule.StartTime.ToString("hh:mm tt")</td>
                                    <td>@schedule.EndTime.ToString("hh:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="border rounded p-3 text-center text-muted">
                    <i class="bi bi-calendar-x fs-4"></i>
                    <p class="mb-0 mt-2">No schedule available for this doctor.</p>
                </div>
            }
        </div>
    </section>
</div>