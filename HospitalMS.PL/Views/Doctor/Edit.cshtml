@using HospitalMS.BLL.ModelVM.Doctor
@model UpdateDoctorViewModel

@{
    ViewData["Title"] = "Edit Doctor";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Management</p>
                <h1 class="h3 mb-1">Edit Doctor</h1>
                <p class="text-muted mb-0">Update doctor information.</p>
            </div>
        </div>
    </div>

    <section class="row g-3">
        <div class="col-12">
            <form asp-action="Edit" method="post" class="panel">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="Id" type="hidden" />

                <div class="panel-header">
                    <h2 class="h5 mb-1 section-title">Doctor Information</h2>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Doctor Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NationalId" class="form-label">National ID</label>
                        <input asp-for="NationalId" type="text" inputmode="numeric" maxlength="14" class="form-control" />
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label">Department</label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                            <option value="" disabled selected hidden>Select Department</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SpecialtyId" class="form-label">Specialty</label>
                        <select asp-for="SpecialtyId" asp-items="ViewBag.Specialties" class="form-select">
                            <option value="" disabled selected hidden>Select Specialty</option>
                        </select>
                        <span asp-validation-for="SpecialtyId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="YearsOfExperience" class="form-label">Years Of Experience</label>
                        <input asp-for="YearsOfExperience" type="number" min="0" class="form-control" />
                        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Salary" class="form-label">Salary</label>
                        <input asp-for="Salary" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="HireDate" class="form-label">Hire Date</label>
                        <input asp-for="HireDate" type="date" class="form-control" />
                        <span asp-validation-for="HireDate" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Bio" class="form-label">Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="4" maxlength="1000"
                                  placeholder="Enter doctor bio..."></textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <span asp-validation-for="Bio" class="text-danger"></span>
                            <small id="bioCounter" class="text-muted">0 / 1000 characters</small>
                        </div>
                    </div>

                    <div class="col-12">
                        <hr class="my-3" />

                        <div class="d-flex justify-content-between align-items-center py-2 mb-2">
                            <h2 class="h5 mb-0 section-title">Doctor Schedule</h2>

                            <a asp-controller="DoctorSchedule" asp-action="Create" asp-route-doctorId="@Model.Id"
                               asp-permission="Doctors.Schedule" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle me-1"></i> Add Schedule
                            </a>
                        </div>

                        @if (Model.Schedules != null && Model.Schedules.Any())
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Days</th>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var schedule in Model.Schedules)
                                        {
                                            <tr>
                                                <td>@schedule.Days</td>
                                                <td>@schedule.StartTime.ToString("hh:mm tt")</td>
                                                <td>@schedule.EndTime.ToString("hh:mm tt")</td>
                                                <td class="text-center">
                                                    <a asp-controller="DoctorSchedule" asp-action="Edit"
                                                       asp-route-id="@schedule.Id" asp-permission="Doctors.Schedule"
                                                       class="btn btn-primary btn-sm" title="Edit schedule">
                                                        <i class="bi bi-pencil-fill me-1"></i> Edit
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="border rounded p-4 text-center text-muted">
                                <i class="bi bi-calendar-x fs-3"></i>
                                <p class="mb-0 mt-2">No schedule available for this doctor.</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary" type="submit">Update Doctor</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>

    <script src="~/js/doctor_edit.js"></script>
}