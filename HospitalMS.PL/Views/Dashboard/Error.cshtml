@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
    ViewData["TitleForHeader"] = "Something went wrong.";
}
<div class="mb-4 text-center">
    <div class="mb-3">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;" aria-hidden="true"></i>
    </div>
    <h1 class="h3 mb-1">Something went wrong</h1>
    <p class="text-muted mb-0">An unexpected error occurred. Please try again later.</p>
</div>

<a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100 mt-3">Back to dashboard</a>