@using HospitalMS.BLL.ModelVM.UserAccount
@using HospitalMS.DAL.Enums
@model CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
    Layout = "_StaffLayout";
}
<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Management</p>
                <h1 class="h3 mb-1">Add User</h1>
                <p class="text-muted mb-0">Create a new user.</p>
            </div>
        </div>
        <div class="heading-actions">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Users
            </a>
        </div>
    </div>

    <section class="row g-3">
        <div class="col-12">
            <form asp-action="Create" method="post" class="panel needs-validation" novalidate>
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="panel-header">
                    <div>
                        <h2 class="h5 mb-1 section-title">
                            <span>User Information</span>
                        </h2>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" asp-for="FullName">Full Name</label>
                        <input class="form-control" asp-for="FullName" id="fullName" required>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="emailPrefix">Email</label>
                        <div class="input-group">
                            <input type="text" id="emailPrefix" class="form-control" />
                            <span class="input-group-text" id="emailSuffix">@@hospital.com</span>
                        </div>
                        <input type="hidden" asp-for="Email" id="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label">Role</label>
                        <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select">
                            <option value="">Select Role</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UserType" class="form-label">User Type</label>
                        <select asp-for="UserType" class="form-select" id="userType">
                            <option value="Admin" selected="@(Model.UserType == UserType.Admin)">Admin</option>
                            <option value="Staff" selected="@(Model.UserType == UserType.Staff)">Staff</option>
                        </select>
                        <span asp-validation-for="UserType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6" id="staffTypeContainer">
                        <label asp-for="StaffType" class="form-label">Staff Type</label>
                        <select asp-for="StaffType" class="form-select" id="staffType">
                            <option value="">Select Staff Type</option>
                            @foreach (var type in Enum.GetValues<StaffType>())
                            {
                                <option value="@type"
                                        data-staff-type="@type"
                                        selected="@(Model.StaffType == type)">
                                    @type
                                </option>
                            }
                        </select>
                        <span asp-validation-for="StaffType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6" id="doctorContainer">
                        <label asp-for="DoctorId" class="form-label">Doctor</label>
                        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select" id="doctor">
                            <option value="">Select Doctor</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6" id="receptionistContainer">
                        <label asp-for="ReceptionistId" class="form-label">Receptionist</label>
                        <select asp-for="ReceptionistId" asp-items="ViewBag.Receptionists" class="form-select" id="receptionist">
                            <option value="">Select Receptionist</option>
                        </select>
                        <span asp-validation-for="ReceptionistId" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                        Create
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const DOMAIN = "@@hospital.com";

            const userType = document.getElementById("userType");
            const staffTypeContainer = document.getElementById("staffTypeContainer");
            const staffType = document.getElementById("staffType");

            const doctorContainer = document.getElementById("doctorContainer");
            const doctor = document.getElementById("doctor");

            const receptionistContainer = document.getElementById("receptionistContainer");
            const receptionist = document.getElementById("receptionist");

            const fullName = document.getElementById("fullName");
            const emailPrefix = document.getElementById("emailPrefix");
            const emailSuffix = document.getElementById("emailSuffix");
            const email = document.getElementById("email");
            const initialEmail = email.value;

            let currentEmailType = "";

            function updateFullEmail() {
                const prefix = emailPrefix.value.trim();
                email.value = prefix ? prefix + emailSuffix.textContent : "";
            }

            function updateEmailSuffix(type) {
                currentEmailType = type || "";
                emailSuffix.textContent = type ? "." + type + DOMAIN : DOMAIN;
                updateFullEmail();
            }

            function generateEmailPrefix(name) {
                emailPrefix.value = (name || "")
                    .trim()
                    .toLowerCase()
                    .replace(/[^a-z0-9\s]/g, "")
                    .replace(/\s+/g, ".");
                updateFullEmail();
            }

            function selectedText(select) {
                if (!select || !select.value) return "";
                return select.options[select.selectedIndex].text.trim();
            }

            function setFullNameFromSelectedPerson(name) {
                if (!fullName.value.trim() && name) {
                    fullName.value = name;
                    generateEmailPrefix(name);
                }
            }

            function handleStaffTypeChange() {
                const selectedOption = staffType.options[staffType.selectedIndex];
                const selected = selectedOption ? selectedOption.dataset.staffType : "";

                const isDoctor = selected === "Doctor";
                const isReceptionist = selected === "Receptionist";

                doctorContainer.style.display = isDoctor ? "block" : "none";
                receptionistContainer.style.display = isReceptionist ? "block" : "none";

                if (!isDoctor) doctor.value = "";
                if (!isReceptionist) receptionist.value = "";

                updateEmailSuffix(selected ? selected.toLowerCase() : "");
            }

            function handleUserTypeChange() {
                if (userType.value === "Staff") {
                    staffTypeContainer.style.display = "block";
                    handleStaffTypeChange();
                    return;
                }

                staffTypeContainer.style.display = "none";
                doctorContainer.style.display = "none";
                receptionistContainer.style.display = "none";

                staffType.value = "";
                doctor.value = "";
                receptionist.value = "";

                updateEmailSuffix("admin");
            }

            fullName.addEventListener("input", () => generateEmailPrefix(fullName.value));
            emailPrefix.addEventListener("input", updateFullEmail);
            userType.addEventListener("change", handleUserTypeChange);
            staffType.addEventListener("change", handleStaffTypeChange);

            doctor.addEventListener("change", function () {
                setFullNameFromSelectedPerson(selectedText(doctor));
            });

            receptionist.addEventListener("change", function () {
                setFullNameFromSelectedPerson(selectedText(receptionist));
            });

            handleUserTypeChange();

            if (initialEmail) {
                let local = initialEmail.split("@@")[0];
                const typeSuffix = currentEmailType ? "." + currentEmailType : "";
                if (typeSuffix && local.endsWith(typeSuffix)) {
                    local = local.slice(0, -typeSuffix.length);
                }
                emailPrefix.value = local;
                updateFullEmail();
            }
        });
    </script>
}