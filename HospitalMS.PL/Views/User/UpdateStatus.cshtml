@using HospitalMS.BLL.ModelVM.UserAccount
@model UpdateStatusViewModel
@{
    ViewData["Title"] = "Update Account Status";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-toggle2-on" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Management</p>
                <h1 class="h3 mb-1">Update Account Status</h1>
                <p class="text-muted mb-0">Change the account status for @Model.FullName.</p>
            </div>
        </div>
    </div>

    <section class="panel mt-3">
        <div class="panel-body p-4">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false)
                </div>
            }

            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="CurrentStatus" />

                <div class="mb-3">
                    <label class="form-label">Current Status</label>
                    <div>
                        <span class="badge text-bg-secondary fs-6">@Model.CurrentStatus</span>
                    </div>
                </div>

                @if (Model.AllowedStatuses.Any())
                {
                    <div class="mb-4">
                        <label class="form-label">New Status</label>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var status in Model.AllowedStatuses)
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="NewStatus"
                                           id="status_@status"
                                           value="@status">
                                    <label class="form-check-label" for="status_@status">
                                        @status
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="NewStatus" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Update Status
                        </button>
                        <a  asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        No status changes are available for this account.
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                }
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
   
}