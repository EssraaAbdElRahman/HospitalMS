@using HospitalMS.DAL.Enums
@model HospitalMS.BLL.ModelVM.Appointment.UpdateAppointmentViewModel
@{
    ViewData["Title"] = "Appointment Details";
    Layout = "_StaffLayout";
}
@functions {
    string GetStatusClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Scheduled => "text-bg-secondary",
            AppointmentStatus.Check_in => "text-bg-info",
            AppointmentStatus.Completed => "text-bg-success",
            AppointmentStatus.Canceled => "text-bg-danger",
            AppointmentStatus.No_show => "text-bg-warning",
            _ => "text-bg-secondary"
        };
    }
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Appointment</p>
                <h1 class="h3 mb-1">Appointment Details</h1>
                <p class="text-muted mb-0">@Model.PatientName with @Model.DoctorName</p>
            </div>
        </div>
        <div class="heading-actions d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            @if (Model.Status == AppointmentStatus.Scheduled)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" asp-permission="Appointments.Edit" class="btn btn-primary btn-sm">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <button type="button" class="btn btn-outline-danger btn-sm"
                        data-bs-toggle="modal" data-bs-target="#deleteAppointmentModal">
                    <i class="bi bi-trash"></i> Delete
                </button>
            }
        </div>
    </div>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success mt-3" role="alert">@successMsg</div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger mt-3" role="alert">@errorMsg</div>
    }

    <section class="panel mt-3">
        <div class="panel-header">
            <h2 class="h6 mb-0 section-title">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Appointment Info</span>
            </h2>
            <span class="badge @GetStatusClass(Model.Status)">
                @Model.Status.ToString().Replace("_", " ")
            </span>
        </div>
        <div class="p-3">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted fw-normal">Patient</dt>
                <dd class="col-sm-9">@Model.PatientName</dd>

                <dt class="col-sm-3 text-muted fw-normal">Doctor</dt>
                <dd class="col-sm-9">@Model.DoctorName</dd>

                <dt class="col-sm-3 text-muted fw-normal">Date &amp; Time</dt>
                <dd class="col-sm-9">@Model.AppointmentDate.ToString("dd MMM yyyy, hh:mm tt")</dd>

                <dt class="col-sm-3 text-muted fw-normal">Type</dt>
                <dd class="col-sm-9">@Model.AppointmentType</dd>
            </dl>
        </div>
    </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteAppointmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    Delete Appointment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-2">Are you sure you want to delete this appointment?</p>
                <strong>@Model.PatientName — @Model.AppointmentDate.ToString("dd MMM yyyy, hh:mm tt")</strong>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteApp" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>