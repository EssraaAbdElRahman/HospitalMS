@using HospitalMS.BLL.ModelVM.Appointment
@using HospitalMS.DAL.Enums
@model NewAppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-2">
    <div class="page-heading mb-2">
        <div class="page-heading-copy">
            <span class="page-icon">
                <i class="bi bi-calendar-plus" aria-hidden="true"></i>
            </span>
            <div>
                <p class="eyebrow mb-0">Management</p>
                <h1 class="h3 mb-0">Book Appointment</h1>
            </div>
        </div>
    </div>

    <section class="panel">
        <div class="panel-header py-2">
            <h2 class="h5 mb-0 section-title">
                <i class="bi bi-person-badge"></i>
                <span>@Model.PatientName</span>
            </h2>
            <p class="text-muted mb-0">
                National ID: @Model.NationalId &nbsp;|&nbsp; Gender: @Model.Gender
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 mt-3 mb-3 px-3 py-2 rounded"
             style="background-color: #f8f9fa; border: 1px solid #dee2e6; color: #495057;">

            <i class="bi bi-info-circle text-primary fs-5"></i>

            <span id="appointmentInfoNotice">
                Please select a <strong>Department</strong> first to enable doctor and available schedule slots.
            </span>

        </div>


        <div class="p-3">
            <form asp-action="CreateByPatient" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="PatientName" />
                <input type="hidden" asp-for="NationalId" />
                <input type="hidden" asp-for="Gender" />

                <div class="row g-3">
                    <!-- 1. القسم -->
                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label">Department</label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select" id="DepartmentId">
                            <option value="" disabled selected hidden="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>

              
                    <div class="col-md-6">
                        <label asp-for="DoctorId" class="form-label">Doctor</label>
                        <select asp-for="DoctorId" class="form-select" id="DoctorId" disabled>
                            <option value="" disabled selected hidden>-- Select Department First --</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AppointmentType" class="form-label">Appointment Type</label>
                        <select asp-for="AppointmentType" asp-items="Html.GetEnumSelectList<AppointmentType>()" class="form-select"></select>
                        <span asp-validation-for="AppointmentType" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Date</label>
                        <input type="date" id="appointmentDate" name="AppointmentDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" disabled />
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Available Time</label>
                        <select id="availableSlots" name="AppointmentTime" class="form-select" disabled>
                            <option value="" disabled selected hidden>-- Select Date First --</option>
                        </select>
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2 justify-content-end">
                    <a asp-controller="Patient" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Save Appointment
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const departmentSelect = document.getElementById('DepartmentId');
        const doctorSelect = document.getElementById('DoctorId');
        const dateInput = document.getElementById('appointmentDate');
        const slotsSelect = document.getElementById('availableSlots');

       
        departmentSelect.addEventListener('change', async function() {
            const deptId = this.value;

            resetDoctorSelect('-- Loading Doctors... --', true);
            resetDateAndSlots();

       
            if (!deptId) {
                resetDoctorSelect('-- Select Department First --', true);
                return;
            }

            try {
                const response = await fetch(`/Appointment/GetDoctorsByDepartment?departmentId=${deptId}`);
                const doctors = await response.json();

            
                if (!doctors || doctors.length === 0) {
                    resetDoctorSelect('No doctors available in this department', true);
                    return;
                }

             
                doctorSelect.innerHTML = '<option value="" disabled selected>-- Select Doctor --</option>';
                doctors.forEach(doc => {
                    const opt = document.createElement('option');
                    opt.value = doc.id;
                    opt.textContent = doc.name;
                    doctorSelect.appendChild(opt);
                });

                doctorSelect.disabled = false;

            } catch (err) {
                resetDoctorSelect('Error loading doctors', true);
            }
        });

        doctorSelect.addEventListener('change', function() {
            resetDateAndSlots();
            if (this.value) {
                dateInput.disabled = false;
            }
        });

        // 3. عند اختيار التاريخ
        dateInput.addEventListener('change', async function() {
            const doctorId = doctorSelect.value;
            const date = this.value;

            slotsSelect.innerHTML = '<option value="" disabled selected>-- Loading Slots... --</option>';
            slotsSelect.disabled = true;

            if (!doctorId || !date) return;

            try {
                const response = await fetch(`/Appointment/GetAvailableSlots?doctorId=${doctorId}&date=${date}`);
                const slots = await response.json();

                if (!slots || slots.length === 0) {
                    slotsSelect.innerHTML = '<option value="" disabled selected>No slots available on this date</option>';
                    return;
                }

                slotsSelect.innerHTML = '<option value="" disabled selected>-- Select Time --</option>';
                slots.forEach(slot => {
                    const opt = document.createElement('option');
                    opt.value = slot;
                    opt.textContent = slot;
                    slotsSelect.appendChild(opt);
                });

                slotsSelect.disabled = false;

            } catch (err) {
                slotsSelect.innerHTML = '<option value="" disabled selected>Error loading slots</option>';
            }
        });

  
        function resetDoctorSelect(placeholderText, isDisabled) {
            doctorSelect.innerHTML = `<option value="" disabled selected>${placeholderText}</option>`;
            doctorSelect.disabled = isDisabled;
        }

        function resetDateAndSlots() {
            dateInput.value = '';
            dateInput.disabled = true;

            slotsSelect.innerHTML = '<option value="" disabled selected>-- Select Date First --</option>';
            slotsSelect.disabled = true;
        }
    </script>
}