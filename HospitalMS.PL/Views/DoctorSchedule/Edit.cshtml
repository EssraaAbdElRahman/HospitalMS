@using HospitalMS.BLL.ModelVM.DoctorSchedule
@using HospitalMS.DAL.Enums
@model UpdateDoctorScheduleViewModel

@{
    ViewData["Title"] = "Edit Doctor Schedule";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-calendar-week" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Management</p>
                <h1 class="h3 mb-1">Edit Doctor Schedule</h1>
                <p class="text-muted mb-0">Update doctor schedule information.</p>
            </div>
        </div>
    </div>

    <section class="row g-3">
        <div class="col-12">
            <form asp-action="Edit" method="post" class="panel">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="Id" type="hidden" />

                <div class="panel-header">
                    <h2 class="h5 mb-1 section-title">Doctor Schedule Information</h2>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DoctorId" class="form-label">Doctor</label>
                        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select">
                            <option value="">Select Doctor</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>

                        <div class="mt-3">
                            <label class="form-label">Days</label>
                            <div class="border rounded p-3">
                                @foreach (var day in Enum.GetValues<Days>())
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="Days"
                                               value="@day" id="day-@day"
                                               checked="@(Model.Days?.Contains(day) == true)" />
                                        <label class="form-check-label" for="day-@day">@day</label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="Days" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="StartTime" class="form-label">Start Time</label>
                            <input asp-for="StartTime" type="time" class="form-control"
                                   value="@(Model.StartTime == default ? "" : Model.StartTime.ToString("HH:mm"))" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="EndTime" class="form-label">End Time</label>
                            <input asp-for="EndTime" type="time" class="form-control"
                                   value="@(Model.EndTime == default ? "" : Model.EndTime.ToString("HH:mm"))" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary" type="submit">Update Doctor Schedule</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}