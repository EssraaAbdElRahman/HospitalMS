@using HospitalMS.BLL.ModelVM.DoctorSchedule
@model DoctorScheduleDetailsViewModel

@{
    ViewData["Title"] = "Doctor Schedule Details";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-calendar-week" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Doctor Schedules</p>
                <h1 class="h3 mb-1">@Model.DoctorName</h1>
                <p class="text-muted mb-0">View doctor schedule information.</p>
            </div>
        </div>
        <div class="heading-actions d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-permission="Doctors.Schedule" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <section class="panel mt-3">
        <div class="p-3">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted fw-normal">Doctor</dt>
                <dd class="col-sm-9">@Model.DoctorName</dd>

                <dt class="col-sm-3 text-muted fw-normal">Days</dt>
                <dd class="col-sm-9">@Model.Days</dd>

                <dt class="col-sm-3 text-muted fw-normal">Start Time</dt>
                <dd class="col-sm-9">@Model.StartTime.ToString("hh:mm tt")</dd>

                <dt class="col-sm-3 text-muted fw-normal">End Time</dt>
                <dd class="col-sm-9">@Model.EndTime.ToString("hh:mm tt")</dd>

                <dt class="col-sm-3 text-muted fw-normal">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
            </dl>
        </div>
    </section>
</div>