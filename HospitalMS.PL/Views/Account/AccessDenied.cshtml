@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
    ViewData["TitleForHeader"] = "You do not have permission to access this page.";
}
<div class="mb-4 text-center">
    <div class="mb-3">
        <i class="bi bi-shield-exclamation text-danger" style="font-size: 3rem;" aria-hidden="true"></i>
    </div>
    <h1 class="h3 mb-1">Access Denied</h1>
    <p class="text-muted mb-0">You do not have permission to access this page.</p>
</div>

<a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100">
    <i class="bi bi-house-door" aria-hidden="true"></i> Back to dashboard
</a>

<div class="auth-footer">
    <a asp-controller="Account" asp-action="Login">Back to login</a>
</div>