@{
    ViewData["Title"] = "Request Sent";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <i class="bi bi-envelope-check text-primary" style="font-size: 3rem;"></i>
    <h2 class="h4 mt-3 mb-2">Request Submitted</h2>
    <p class="text-muted">
        If this email is registered in our system, your password reset request has been received.
        Please contact your administrator to proceed.
    </p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-2">Back to Login</a>
</div>