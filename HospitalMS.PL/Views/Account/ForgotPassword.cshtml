@using HospitalMS.BLL.ModelVM.Account
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["TitleForHeader"] = "Request a password reset.";
    Layout = "_AuthLayout";
}
<section class="auth-card">
    <form asp-action="ForgotPassword" method="post" class="needs-validation" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-4">
            <p class="eyebrow mb-1">Secure Access</p>
            <h1 class="h3 mb-1">Forgot password?</h1>
            <p class="text-muted mb-0">Request a password reset for your account.</p>
        </div>

        <div class="mb-4">
            <label class="form-label" asp-for="Email">Email address</label>
            <input class="form-control" asp-for="Email" type="email">
            <span asp-validation-for="Email" class="invalid-feedback"></span>
        </div>

        <button class="btn btn-primary w-100" type="submit">
            <i class="bi bi-envelope-arrow-up" aria-hidden="true"></i> Request Reset
        </button>
    </form>
    <div class="auth-footer">Remembered it? <a asp-action="Login">Back to login</a></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}