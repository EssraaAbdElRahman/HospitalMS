@{
    ViewData["Title"] = "Invalid Link";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
    <h2 class="h4 mt-3 mb-2">Invalid or Expired Link</h2>
    <p class="text-muted">
        This activation link is invalid or has expired. Please contact your administrator to request a new one.
    </p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-2">Go to Login</a>
</div>
