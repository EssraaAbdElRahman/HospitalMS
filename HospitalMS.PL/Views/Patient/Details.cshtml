@model HospitalMS.BLL.ModelVM.Patient.PatientDetailsViewModel

@{
    ViewData["Title"] = "Patient Details";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Patients</p>
                <h1 class="h3 mb-1">@Model.PatientName</h1>
                <p class="text-muted mb-0">View patient information.</p>
            </div>
        </div>
        <div class="heading-actions d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-permission="Patients.Edit" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-controller="Appointment" asp-action="PatientAppointments" asp-route-patientId="@Model.Id"
               asp-permission="Appointments.View" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-calendar-week"></i> Appointments
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <section class="panel mt-3">
        <div class="p-3">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted fw-normal">Patient Name</dt>
                <dd class="col-sm-9">@Model.PatientName</dd>

                <dt class="col-sm-3 text-muted fw-normal">Gender</dt>
                <dd class="col-sm-9">@Model.Gender</dd>

                <dt class="col-sm-3 text-muted fw-normal">National ID</dt>
                <dd class="col-sm-9">@Model.NationalId</dd>

                <dt class="col-sm-3 text-muted fw-normal">Address</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</dd>

                <dt class="col-sm-3 text-muted fw-normal">Country</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Country) ? "—" : Model.Country)</dd>

                <dt class="col-sm-3 text-muted fw-normal">City</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.City) ? "—" : Model.City)</dd>

                <dt class="col-sm-3 text-muted fw-normal">Notes</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>

                <dt class="col-sm-3 text-muted fw-normal">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
            </dl>
        </div>
    </section>
</div>