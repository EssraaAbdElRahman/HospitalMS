 @model HospitalMS.BLL.ModelVM.Specialization.SpecializationDetailsViewModel

@{
    ViewData["Title"] = "Specialization Details";
    Layout = "_StaffLayout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Specializations</p>
                <h1 class="h3 mb-1">@Model.Name</h1>
                <p class="text-muted mb-0">View Specialization information.</p>
            </div>
        </div>
        <div class="heading-actions d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-permission="Settings.Manage" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <section class="panel mt-3">
        <div class="p-3">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted fw-normal">Specialization Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 text-muted fw-normal">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
            </dl>
        </div>
    </section>
</div>