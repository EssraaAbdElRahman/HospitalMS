@model HospitalMS.BLL.ModelVM.Role.RoleDetailsViewModel
@{
    ViewData["Title"] = "Role Details";
    Layout = "_StaffLayout";

    var groupedPermissions = Model.Permissions
        .GroupBy(p => p.Split('.')[0])
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Roles</p>
                <h1 class="h3 mb-1">@Model.Name</h1>
                <p class="text-muted mb-0">@Model.Permissions.Count permission(s) · @Model.UsersCount user(s) assigned</p>
            </div>
        </div>
        <div class="heading-actions">
            <a asp-action="Index" asp-controller="Role" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <!-- Permissions grouped by module -->
        <div class="col-12 col-lg-7">
            <section class="panel h-100">
                <div class="panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-key"></i> Permissions</h2>
                </div>
                <div class="panel-body p-3">
                    @if (groupedPermissions.Any())
                    {
                        @foreach (var group in groupedPermissions)
                        {
                            <div class="mb-3">
                                <h3 class="h6 text-muted border-bottom pb-1 mb-2">@group.Key</h3>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var permission in group.OrderBy(p => p))
                                    {
                                        var parts = permission.Split('.', 2);
                                        var action = parts.Length > 1 ? parts[1] : permission;
                                        <span class="badge text-bg-light border">
                                            <i class="bi bi-check-circle-fill text-success me-1"></i>@action
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No permissions assigned to this role.</p>
                    }
                </div>
            </section>
        </div>

        <!-- Assigned Users -->
        <div class="col-12 col-lg-5">
            <section class="panel h-100">
                <div class="panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-people"></i> Assigned Users (@Model.UsersCount)</h2>
                </div>
                <div class="panel-body p-3">
                    @if (Model.AssignedUsers.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var user in Model.AssignedUsers)
                            {
                                <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <div>
                                        <a asp-controller="User" asp-action="Details" asp-route-id="@user.Id">
                                            @user.FullName
                                        </a>
                                        <div class="text-muted small">@user.Email</div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No users are currently assigned to this role.</p>
                    }
                </div>
            </section>
        </div>
    </div>
</div>