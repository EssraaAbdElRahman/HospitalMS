@using HospitalMS.BLL.ModelVM.Role
@model CreateRoleViewModel
@{
    ViewData["Title"] = "Create Role";
    Layout = "_StaffLayout";
}
<div class="container-fluid px-3 px-lg-4 py-4">

    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
            <div>
                <p class="eyebrow mb-1">Management</p>
                <h1 class="h3 mb-1">Add Role</h1>
                <p class="text-muted mb-0">Create a new Role .</p>
            </div>
        </div>
        <div class="heading-actions">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Roles</a>
        </div>
    </div>

    <section class="row g-3">
        <div class="col-12 ">
<form asp-action="Create" method="post" class="panel needs-validation" novalidate>
    <div asp-validation-summary="All" class="text-danger"></div>
    @Html.AntiForgeryToken()
               

                <div class="panel-header">
                    <div>
                        <h2 class="h5 mb-1 section-title">
                            <span>Role Information</span>
                        </h2>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" asp-for="RoleName">Role name</label>
                        <input class="form-control" asp-for="RoleName" required>
                        <span asp-validation-for="RoleName"
                              class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="RoleDescription">Description</label>

                        <textarea class="form-control" asp-for="RoleDescription" rows="4" placeholder="Optional description of what this role is for"></textarea>
                        <span asp-validation-for="RoleDescription" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                        Create
                    </button>
                        </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}