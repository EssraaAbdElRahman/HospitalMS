@using HospitalMS.BLL.ModelVM.Pagination
@using HospitalMS.BLL.ModelVM.Role
@model PagedResult<RoleListItemViewModel>
@{
    ViewData["Title"] = "Roles";
    Layout = "_StaffLayout";
}
<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>
            </span>
            <div>
                <p class="eyebrow mb-1">Management</p>
                <h1 class="h3 mb-1">Roles</h1>
            </div>
        </div>
        <div class="heading-actions">
            <a class="btn btn-primary btn-sm" asp-action="Create">
                <i class="bi bi-person-plus" aria-hidden="true"></i>
                Create Role
            </a>
        </div>
    </div>
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success mt-3" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger mt-3" role="alert">@error</div>
    }
    <section class="panel mt-3">
        <div class="panel-header">
            <div>
                <h2 class="h5 mb-1 section-title">
                    <i class="bi bi-table" aria-hidden="true"></i>
                    <span>Role List</span>
                </h2>

                <p class="text-muted mb-0">
                    Total Roles: @Model.TotalCount
                </p>
            </div>

            <form asp-action="Index"
                  method="get"
                  class="d-flex align-items-center gap-2">

                <input class="form-control form-control-sm table-search"
                       type="search"
                       name="search"
                       value="@Model.SearchTerm"
                       placeholder="Search roles"
                       aria-label="Search roles">

                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-search"></i>
                    Search
                </button>

            </form>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="rolesTable" data-searchable-table>
                <thead>
                    <tr>
                        <th scope="col">Role</th>
                        <th scope="col">Description</th>
                        <th scope="col">Users count</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var role in Model.Items)
                    {
                        <tr>
                            <td>@role.Name</td>
                            <td>@role.Description</td>
                            <td>@role.UserCount</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-success btn-sm rounded-circle action-btn me-1"
                                   title="Details" aria-label="Details"><i class="bi bi-eye-fill"></i></a>

                                @if (!role.IsSystemRole)
                                {
                                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-primary btn-sm rounded-circle action-btn me-1"
                                       title="Edit Role" aria-label="Edit role"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-controller="Permissions" asp-action="Index" asp-route-id="@role.Id"
                                       class="btn btn-warning btn-sm rounded-circle action-btn me-1"
                                       title="Manage Permissions" aria-label="Manage permissions"><i class="bi bi-key-fill"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", new PaginationViewModel
        {
            CurrentPage = Model.CurrentPage,
            PageSize = Model.PageSize,
            TotalCount = Model.TotalCount,
            TotalPages = Model.TotalPages,
            SearchTerm = Model.SearchTerm
        })
    </section>
</div>

 